meta {
  name: Search open repair tickets
  type: http
  seq: 2
}

post {
  url: {{hubspotBase}}/crm/v3/objects/tickets/search
  body: json
  auth: inherit
}

body:json {
  {
    "filterGroups": [
      {
        "filters": [
          { "propertyName": "hs_pipeline", "operator": "EQ", "value": "{{repairPipelineId}}" },
          { "propertyName": "hs_pipeline_stage", "operator": "IN", "values": ["1", "2", "6385083617"] }
        ]
      }
    ],
    "properties": ["subject", "content", "hs_pipeline_stage", "requested_repair_date", "restarters_category", "repair_item_brand"],
    "sorts": [{ "propertyName": "createdate", "direction": "ASCENDING" }],
    "limit": 100
  }
}

vars:pre-request {
  fixture: hubspot_api/searchOpenTicketsResponse.json
}

docs {
  What GET /api/tickets will run. Open stages are New, In Progress and Needs follow-up.
  Read-only, even though it's a POST.
}
